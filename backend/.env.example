# Use demo para o ambiente acadêmico com registros temporários.
INFOTAG_MODE=demo
PORT=5000

# Para usar Firebase, defina INFOTAG_MODE=firebase e preencha as variáveis.
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=

# Habilite o cookie Secure quando o serviço estiver sob HTTPS.
# INFOTAG_SECURE_COOKIES=1
